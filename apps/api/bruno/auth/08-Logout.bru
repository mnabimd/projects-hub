meta {
  name: Logout
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("accessToken", "");
    bru.setVar("refreshToken", "");
    bru.setVar("adminAccessToken", "");
    bru.setVar("studentAccessToken", "")
  }
}

assert {
  res.status: eq 204
}
