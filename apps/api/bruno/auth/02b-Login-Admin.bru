meta {
  name: Login (Admin)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}


script:pre-request {
  const email = bru.getEnvVar("adminEmail") || bru.getVar("adminEmail");
  if (!email) {
    bru.setVar("adminEmail", "admin@projectshub.com");
  }
  const password = bru.getEnvVar("adminPassword") || bru.getVar("adminPassword");
  if (!password) {
    bru.setVar("adminPassword", "Password123!");
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data.tokens && data.tokens.access) {
      bru.setEnvVar("accessToken", data.tokens.access.token);
      bru.setVar("accessToken", data.tokens.access.token);
      bru.setEnvVar("adminAccessToken", data.tokens.access.token);
      bru.setVar("adminAccessToken", data.tokens.access.token);
    }
    if (data.tokens && data.tokens.refresh) {
      bru.setEnvVar("refreshToken", data.tokens.refresh.token);
      bru.setVar("refreshToken", data.tokens.refresh.token);
    }
    if (data.user && data.user.id) {
      bru.setEnvVar("adminUserId", data.user.id);
      bru.setVar("adminUserId", data.user.id);
      bru.setEnvVar("userId", data.user.id);
      bru.setVar("userId", data.user.id);
    }
    if (data.user && data.user.role) {
      bru.setEnvVar("userRole", data.user.role);
      bru.setVar("userRole", data.user.role);
    }
  }
}

assert {
  res.status: eq 200
  res.body.user.role: in [admin, super_admin]
  res.body.tokens.access.token: isDefined
}
