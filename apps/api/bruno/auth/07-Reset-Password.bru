meta {
  name: Reset Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/reset-password?token={{resetPasswordToken}}
  body: json
  auth: none
}

params:query {
  token: {{resetPasswordToken}}
}

body:json {
  {
    "password": "newPassword2"
  }
}

