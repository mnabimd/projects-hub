meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:4500/v1
}

script:pre-request {
  const email = bru.getEnvVar("userEmail") || bru.getVar("userEmail");
  if (!email) {
    bru.setVar("userEmail", "test@gmail.com");
  }
  const password = bru.getEnvVar("userPassword") || bru.getVar("userPassword");
  if (!password) {
    bru.setVar("userPassword", "password1");
  }
}

assert {
  res.status: eq 200
  res.body.user: isDefined
  res.body.tokens.access.token: isDefined
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data.tokens && data.tokens.access) {
      bru.setEnvVar("accessToken", data.tokens.access.token);
      bru.setVar("accessToken", data.tokens.access.token);
      if (data.user && (data.user.role === "student" || data.user.role === "user")) {
        bru.setEnvVar("studentAccessToken", data.tokens.access.token);
        bru.setVar("studentAccessToken", data.tokens.access.token);
      }
    }
    if (data.tokens && data.tokens.refresh) {
      bru.setEnvVar("refreshToken", data.tokens.refresh.token);
      bru.setVar("refreshToken", data.tokens.refresh.token);
    }
    if (data.user && data.user.id) {
      bru.setEnvVar("userId", data.user.id);
      bru.setVar("userId", data.user.id);
    }
    if (data.user && data.user.role) {
      bru.setEnvVar("userRole", data.user.role);
      bru.setVar("userRole", data.user.role);
    }
  }
}

tests {
  test("login returns valid JWT tokens", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.tokens.access.token).to.be.a("string");
    expect(body.tokens.refresh.token).to.be.a("string");
  });
}
​