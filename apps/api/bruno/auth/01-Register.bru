meta {
  name: Register User (Disabled - 404 Not Found)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "fullName": "Student Tester",
    "email": "test@gmail.com",
    "password": "password1"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("public registration is disabled and returns 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
