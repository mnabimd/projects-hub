meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "fullName": "Student Tester",
    "email": "test@gmail.com",
    "password": "password1"
  }
}

assert {
  res.status: eq 201
  res.body.user: isDefined
  res.body.tokens.access.token: isDefined
  res.body.tokens.refresh.token: isDefined
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data.tokens && data.tokens.access) {
      bru.setVar("accessToken", data.tokens.access.token);
      bru.setVar("studentAccessToken", data.tokens.access.token);
    }
    if (data.tokens && data.tokens.refresh) {
      bru.setVar("refreshToken", data.tokens.refresh.token);
    }
    if (data.user && data.user.id) {
      bru.setVar("userId", data.user.id);
    }
    bru.setVar("userRole", "user");
  }
}

tests {
  test("registered user receives tokens and user object", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.user.role).to.equal("user");
    expect(body.tokens.access.token).to.be.a("string");
  });
}
​