meta {
  name: Create Tag (Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tags
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Node.js",
    "category": "backend"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq Node.js
  res.body.slug: eq node-js
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data.id) {
      bru.setVar("createdTagId", data.id);
    }
  }
}

tests {
  test("creates tag successfully and returns 201", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.name).to.equal("Node.js");
    expect(body.slug).to.equal("node-js");
  });
}
