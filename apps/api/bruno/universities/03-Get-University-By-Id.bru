meta {
  name: Get University By ID (Public)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/universities/{{createdUniversityId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{createdUniversityId}}
}

tests {
  test("returns university details", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.equal(bru.getVar("createdUniversityId"));
  });
}
