meta {
  name: Get Faculty By ID (Public)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/faculties/{{createdFacultyId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{createdFacultyId}}
  res.body.departments: isDefined
}

tests {
  test("returns faculty details with embedded departments", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.equal(bru.getVar("createdFacultyId"));
    expect(body.departments).to.be.an('array');
  });
}
