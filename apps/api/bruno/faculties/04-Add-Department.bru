meta {
  name: Add Department to Faculty (Admin)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/faculties/{{createdFacultyId}}/departments
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Artificial Intelligence"
  }
}

assert {
  res.status: eq 201
  res.body._id: isDefined
  res.body.name: eq Artificial Intelligence
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data._id) {
      bru.setVar("createdDepartmentId", data._id);
    }
  }
}

tests {
  test("atomically appends department and returns 201", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.name).to.equal("Artificial Intelligence");
    expect(body._id).to.be.a('string');
  });
}
