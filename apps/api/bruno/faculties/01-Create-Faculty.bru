meta {
  name: Create Faculty (Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/universities/{{createdUniversityId}}/faculties
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Faculty of Computer Science",
    "departments": [
      { "name": "Software Engineering" },
      { "name": "Information Technology" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq Faculty of Computer Science
  res.body.departments: isDefined
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data.id) {
      bru.setVar("createdFacultyId", data.id);
    }
  }
}

tests {
  test("creates faculty successfully and returns 201", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.name).to.equal("Faculty of Computer Science");
    expect(body.departments).to.be.an('array');
    expect(body.departments.length).to.equal(2);
  });
}
