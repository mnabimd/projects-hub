meta {
  name: 400 - Validation Error (Invalid Email & Short Password)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Invalid User",
    "email": "not-an-email",
    "password": "123"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq 400
}

tests {
  test("returns 400 for bad payload failing Joi schema", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.be.a("string");
  });
}
